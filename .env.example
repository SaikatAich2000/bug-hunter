# Bug Hunter — copy to .env, edit, then: docker compose down && up -d

# Database — SET A STRONG PASSWORD on a fresh deploy. Postgres bakes these in on
# the FIRST boot of an empty data volume; changing them later does NOT change the
# live DB password (you'd have to ALTER it or recreate the volume). If you leave
# them unset, docker-compose falls back to a well-known default — fine for local
# dev (the port is bound to 127.0.0.1) but not for anything reachable.
POSTGRES_USER=bugtracker
POSTGRES_PASSWORD=bugtracker_pw
POSTGRES_DB=bugtracker
# DATABASE_URL is built automatically from the POSTGRES_* values above for the
# Docker stack. Override it only for an external database or a non-Docker run
# (leave it unset outside Docker and the app falls back to a local SQLite file).
#DATABASE_URL=
# Postgres connection-pool sizing (ignored for SQLite). Lower these on a very
# small VM so a traffic spike can't open pool_size + max_overflow connections.
#DB_POOL_SIZE=5
#DB_MAX_OVERFLOW=10

# Email
EMAIL_BACKEND=console
EMAIL_FROM=Bug Hunter <bugtracker@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
EMAIL_DIGEST_ENABLED=false
EMAIL_DIGEST_LOOKBACK_HOURS=26
# Digest schedule (time + frequency). When EMAIL_DIGEST_CRON holds a standard
# 5-field cron expression, the app runs the digest itself on that schedule — no
# host cron / Task Scheduler needed. Leave it blank to drive the job from an
# external scheduler instead. EMAIL_DIGEST_TIMEZONE is an IANA name (blank = UTC).
# Example — every day at 08:00 India time:
#   EMAIL_DIGEST_CRON=0 8 * * *
#   EMAIL_DIGEST_TIMEZONE=Asia/Kolkata
EMAIL_DIGEST_CRON=
EMAIL_DIGEST_TIMEZONE=

# Reports
MAX_REPORT_ROWS=50000

# Web push
WEB_PUSH_ENABLED=false
FCM_CREDENTIALS_FILE=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# App
APP_NAME=Bug Hunter
APP_VERSION=3.1
APP_BASE_URL=http://localhost:8765
LOG_LEVEL=INFO
#BASE_IMAGE=python:3.12-slim
# Cross-origin allow-list (comma-separated). Blank = same-origin only (the
# secure default). Set your concrete origin(s) for cross-origin clients, e.g.
# CORS_ORIGINS=https://bugs.example.com
CORS_ORIGINS=
# Set true ONLY behind a trusted reverse proxy that sets X-Forwarded-For, so the
# rate limiter buckets per real client IP. Leave false on a direct deploy.
TRUST_PROXY_FORWARDED_FOR=false
# Interactive API docs (/docs, /redoc, /openapi.json). Always on in dev; a
# production deploy (COOKIE_SECURE=true) disables them unless forced on here.
#ENABLE_API_DOCS=false
# Hard ceiling on request body size in bytes (default 60 MiB). Raise for larger
# uploads; requests above it are rejected with 413 before the body is read.
#MAX_REQUEST_BODY_BYTES=62914560

# Auth
SESSION_SECRET=
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@bughunter.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=Admin
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_COMPLEXITY=true
FORGOT_PASSWORD_ENUMERATION_SAFE=true

# Sleuth AI (optional cloud)
SLEUTH_CLOUD_ENABLED=0
# Primary provider — Groq (free tier). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional fallback — OpenRouter. Leave the key blank to run Groq-only.
OPENROUTER_API_KEY=
SLEUTH_RAG_ENABLED=0
SLEUTH_RETRIEVAL_ENABLED=0
SLEUTH_VERIFY_ANSWERS=0
SLEUTH_AGENT_ENABLED=0
SLEUTH_AGENT_MAX_STEPS=4
SLEUTH_EVAL_ENABLED=0
SLEUTH_EVAL_MIN_SCORE=0.5
# Advanced cloud-layer tuning (defaults shown; only used when the cloud layer
# is on). Uncomment to override.
#OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct:free
# Optional local-RAG embeddings only (Groq has no embeddings API); the chat
# assistant never calls Gemini. Set GEMINI_API_KEY only if you turn RAG on.
#GEMINI_API_KEY=
#GEMINI_EMBED_MODEL=text-embedding-004
#SLEUTH_CLOUD_TIMEOUT_S=20
#SLEUTH_CLOUD_MAX_TOKENS=600
# Sampling: temperature + mild penalties make conversational replies natural and
# non-repetitive; tool/judge/agent sub-calls use SLEUTH_CLOUD_TEMPERATURE_TOOLS
# (0) so routing and scoring stay deterministic. SLEUTH_ANSWER_MAX_CHARS caps a
# free-text answer (defense-in-depth, independent of the provider token limit).
#SLEUTH_CLOUD_TEMPERATURE=0.6
#SLEUTH_CLOUD_TEMPERATURE_TOOLS=0.0
#SLEUTH_CLOUD_FREQUENCY_PENALTY=0.3
#SLEUTH_CLOUD_PRESENCE_PENALTY=0.2
#SLEUTH_ANSWER_MAX_CHARS=4000
#SLEUTH_RAG_TOP_K=5
#SLEUTH_CHAT_MEMORY_ENABLED=true
# RAG index + extra docs folders (local RAG only; needs chromadb and, under
# Docker, a mounted volume). Default to paths inside the project directory.
#SLEUTH_RAG_DIR=.sleuth_rag
#SLEUTH_DOCS_DIR=docs
