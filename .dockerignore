__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache

# Local DBs / envs / build artefacts
*.db
*.sqlite
*.sqlite3
.env
.venv
venv
env

# Secrets are provisioned on the host and bind-mounted read-only at runtime
# (see docker-compose.yml) — never ship them in the build context or image
# layers, even if a future Dockerfile switches to a broad COPY.
secrets/
*firebase-admin*.json

# Tests aren't needed at runtime
tests

# Sleuth's optional local LLM model file is mounted as a volume at
# runtime, not baked into the image. (Model files are typically
# 300+ MB — keeping them out of the image saves a lot of bandwidth.)
models/*.gguf
models/*.bin
models/*.safetensors

# Docs / VCS
.git
.gitignore
README.md
*.md

# Agent / editor scratch (never needed at runtime)
.claude
.vscode
.idea

# OS noise
.DS_Store
Thumbs.db
