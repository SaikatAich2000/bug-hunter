# Bug Hunter settings. A blank value means "add yours"; anything not listed here uses its built-in default (docs/environment.md).
# On Render also set: APP_ENV=production, APP_BASE_URL=https://<your-domain>, DATABASE_URL=<Render Postgres URL>, COOKIE_SECURE=true, TRUST_PROXY_FORWARDED_FOR=true, SMTP_USE_TLS=true and your real SMTP_* values.

# App: name, release, public address and run mode
APP_NAME=Bug Hunter
APP_VERSION=
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000

# Database: SQLite file locally; the Compose stack uses the Postgres login
POSTGRES_USER=bugtracker
POSTGRES_PASSWORD=
POSTGRES_DB=bugtracker

# Security: session secret (generate with scripts/gen_local_env_secrets.py)
SESSION_SECRET=

# First admin: created on first start
BOOTSTRAP_ADMIN_EMAIL=admin@bh.local
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Email (SMTP): sends invitations, password resets and digests; add your mail server login
EMAIL_BACKEND=smtp
EMAIL_FROM=Bug Hunter <noreply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Daily digest: one summary e-mail of recent changes, sent on this schedule
EMAIL_DIGEST_ENABLED=true
EMAIL_DIGEST_CRON="0 8 * * *"
EMAIL_DIGEST_TIMEZONE=Asia/Kolkata

# Git integration: create and delete GitHub branches from work items
GIT_BRANCH_CREATION_ENABLED=true
GIT_BRANCH_DELETION_ENABLED=true
GITHUB_TOKEN=
GITHUB_ORGANIZATION=
GIT_CREDENTIAL_ENCRYPTION_KEY=

# Push notifications (Firebase): web and Android push; add the Firebase project values
WEB_PUSH_ENABLED=true
FCM_CREDENTIALS_JSON=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# Sleuth AI assistant: cloud model, document search, agent, tools, answer checks and evaluation; add your keys
SLEUTH_CLOUD_ENABLED=true
SLEUTH_RAG_ENABLED=true
SLEUTH_RETRIEVAL_ENABLED=true
SLEUTH_VERIFY_ANSWERS=true
SLEUTH_AGENT_ENABLED=true
SLEUTH_LLM_TOOLS_ENABLED=true
SLEUTH_EVAL_ENABLED=true
GROQ_API_KEY=
GEMINI_API_KEY=

# Monitoring: OpenTelemetry export; add your SigNoz endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
