# ============================================================
# Bug Hunter — server .env
# ============================================================
# Copy this file to `.env` and edit the values you care about.
# After any change here:
#   docker compose down && docker compose up -d
# (no rebuild needed for env-only changes)


# --- Email (Gmail / SMTP) ---
# EMAIL_BACKEND options:
#   console   (default) Logs every email to stdout. Good for dev.
#   smtp      Sends real email via the SMTP_* settings below.
#   disabled  No-op.
EMAIL_BACKEND=console
EMAIL_FROM=Bug Hunter <bugtracker@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# --- Daily email digest (optional) ---
# When true, the per-operation work-item emails (new item / update /
# assignment / comment / event) are NOT sent immediately. Each operation is
# stored, and the digest job batches every user's operations into ONE grouped
# email. Password-reset and other security emails ALWAYS send immediately.
EMAIL_DIGEST_ENABLED=false
# How far back each run looks for un-emailed operations (slightly over 24h so a
# late/drifting run never drops a day; also bounds the very first run).
EMAIL_DIGEST_LOOKBACK_HOURS=26
# In-app scheduler (optional). Set a standard 5-field cron expression and the
# app runs the digest itself on that schedule — NO host cron needed. Empty =
# run `python -m app.jobs.email_digest` yourself from an external scheduler.
# Keep EMAIL_DIGEST_LOOKBACK_HOURS slightly larger than the interval.
# Examples:
#   0 7 * * *      every day at 07:00            (lookback 26)
#   0 8,18 * * *   twice a day at 08:00 & 18:00  (lookback 14)
#   0 9 * * 1-5    weekdays at 09:00             (lookback 74)
#   0 */6 * * *    every 6 hours                 (lookback 8)
#   */30 * * * *   every 30 minutes              (lookback 2)
EMAIL_DIGEST_CRON=
# IANA timezone the cron above is evaluated in (e.g. Asia/Kolkata). Empty = UTC.
EMAIL_DIGEST_TIMEZONE=


# --- Reports ---
# Max rows a single XLSX export (POST /api/reports/export.xlsx) may materialize
# before the endpoint returns 413. The export builds the whole workbook in
# memory, so this bounds a worst-case export over the full work-item table.
# Generous enough for real audit / compliance exports.
MAX_REPORT_ROWS=50000


# --- Web push (Firebase Cloud Messaging) ---
# Browser push notifications, sent IMMEDIATELY when an operation happens
# (independent of the email digest). OFF by default. To enable, create a
# Firebase project, register a WEB app, and fill these in (see README →
# "Web push notifications"):
WEB_PUSH_ENABLED=false
# Server-side secret: path to the Firebase service-account JSON (Project
# settings → Service accounts → Generate new private key). Mount it read-only.
FCM_CREDENTIALS_FILE=
# Public Firebase WEB-app config (Project settings → General → your web app).
# These are safe to expose — they're served to the browser via /api/push/config.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Web-Push (VAPID) public key: Project settings → Cloud Messaging → Web
# configuration → "Web Push certificates" → Generate key pair.
FIREBASE_VAPID_KEY=


# --- App identity ---
APP_VERSION=3.0

# --- Docker base image (optional) ---
# Override only if you can't reach docker.io directly (corporate network,
# air-gap, mirror). The default pulls python:3.12-slim from Docker Hub.
# Examples:
#   BASE_IMAGE=python:3.12-slim                              # default
#   BASE_IMAGE=mirror.internal.example.com/python:3.12-slim  # corporate mirror
#BASE_IMAGE=python:3.12-slim


# --- Public URL (used in email links) ---
APP_BASE_URL=http://localhost:8765


# ============================================================
# Authentication
# ============================================================

# Long random string used to sign session cookies.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Session lifetime in seconds. 86400 = 1 day.
SESSION_TTL_SECONDS=86400

# Set to true ONLY when serving over HTTPS (real cert).
# If true on plain HTTP, the cookie won't be sent and login will silently break.
COOKIE_SECURE=false


# --- First-time bootstrap admin ---
# Used ONLY when the database has zero users (first run, or after wiping
# the volume). After first login, change the password from the Account
# panel inside the app.
BOOTSTRAP_ADMIN_EMAIL=admin@bughunter.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=Admin


# --- Password policy ---
# Strength rules for NEW passwords. The legacy default "changeme" is ALWAYS
# accepted regardless of these, so existing accounts keep working.
PASSWORD_MIN_LENGTH=8
# Require at least one letter AND one digit (NIST-style: length over symbols).
PASSWORD_REQUIRE_COMPLEXITY=true
# Account-enumeration resistance on /api/auth/forgot-password. true (default,
# most secure) ALWAYS returns 204 so a caller can't probe which emails exist;
# false restores the friendlier-but-leakier 404-on-unknown-address behaviour.
FORGOT_PASSWORD_ENUMERATION_SAFE=true


# ============================================================
# Sleuth — built-in AI assistant
# ============================================================
# Sleuth runs out of the box with NO config: rule-based parsing + a small
# statistical classifier, both pure Python, both fit in 512 MB.
#
# The optional Layer 3 LLM (local llama.cpp) needs a GGUF model at
# models/sleuth.gguf AND more memory. If unset, Sleuth still works.
#
# --- Optional Layer 4: cloud AI (Gemini primary, OpenRouter fallback) ---
# Leave SLEUTH_CLOUD_ENABLED=0 for a fully local, no-egress deployment.
# Set it to 1 and paste a free Google AI Studio key to let Sleuth answer
# free-form natural-language questions. It NEVER writes data and never
# invents counts — data questions are answered by the same SQL handlers.
SLEUTH_CLOUD_ENABLED=0
GEMINI_API_KEY=
# gemini-2.5-flash is the current free-tier model (2.0-flash has no free quota).
GEMINI_MODEL=gemini-2.5-flash
# Optional backup provider used only if Gemini fails (free key from openrouter.ai).
OPENROUTER_API_KEY=
# Document search (RAG) over bugs/comments/docs. Needs `pip install chromadb`
# (or the chromadb extra in the image). Leave 0 to run the AI without it.
SLEUTH_RAG_ENABLED=0
